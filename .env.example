# ox-alpha-review-py runtime configuration
# Copy to .env, keep it mode 0600, and never commit the populated file.

# Required: create a new GitHub App for this bot.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# Alternative to the path above; never set both.
# GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Confirm the final slug after creating the App.
GITHUB_APP_SLUG=ox-alpha-review-bot

# Required: dedicated OpenRouter Free-tier inference key with a verified USD 0 cap.
# Never place an OpenRouter management/provisioning key in this file.
OPENROUTER_API_KEY=

# Shared safe defaults from the pinned review bots.
GITHUB_API_BASE=https://api.github.com
HOST=127.0.0.1
PORT=8025
# Keep true until offline provisioning and every production-readiness check passes.
DRY_RUN=true
# Optional: omit to use the runtime user's home. Services without HOME should set an
# absolute writable path, for example /var/lib/ox-alpha-review-py/repos.
# REPO_CACHE_DIR=/absolute/path/to/.ox-alpha-review-py/repos
GIT_TIMEOUT_SEC=120
FILE_MAX_BYTES=204800
DATA_FILE_MAX_BYTES=20000
WEBHOOK_MAX_BODY_BYTES=2097152
REVIEW_CONCURRENCY=1
REVIEW_QUEUE_MAXSIZE=10

# Intentionally not configurable here: OpenRouter URL/model/provider, fallbacks,
# max_price, tools/plugins, BYOK, quota limit, safety latch, or readiness bypass.
